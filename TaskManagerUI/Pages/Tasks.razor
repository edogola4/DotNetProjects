@page "/"
@using TaskManagerUI.DTOs
@using TaskManagerUI.Services
@using TaskManagerUI.Models
@inject ApiService ApiService
@inject AuthService AuthService
@inject SignalRService SignalRService
@inject NavigationManager Navigation
@implements IAsyncDisposable

<div class="container-fluid py-4">
    @if (!isAuthenticated)
    {
        <div class="text-center">
            <h3 class="text-muted">Please login to view your tasks</h3>
            <a href="/login" class="btn btn-primary">Login</a>
        </div>
    }
    else
    {
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1">My Tasks</h2>
                @if (currentUser != null)
                {
                    <p class="text-muted mb-0">Welcome back, @currentUser.Username</p>
                }
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge @(connectionStatus == "Connected" ? "bg-success" : "bg-secondary")">
                    @connectionStatus
                </span>
                <button class="btn btn-primary" @onclick="ToggleForm">
                    <i class="bi bi-plus"></i> New Task
                </button>
                <button class="btn btn-outline-secondary" @onclick="Logout">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </button>
            </div>
        </div>

        <!-- Task Form Component -->
        @if (showForm)
        {
            <TaskForm Model="newTask" 
                     IsCreating="isCreating" 
                     OnSubmit="CreateTask" 
                     OnCancel="CancelForm" />
        }

        <!-- Loading State -->
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        <!-- Task List -->
        else if (tasks.Any())
        {
            <div class="row g-3">
                @foreach (var task in tasks.OrderBy(t => t.IsCompleted).ThenByDescending(t => t.Priority))
                {
                    <div class="col-md-6 col-lg-4" @key="task.Id">
                        <TaskItem Task="task" 
                                 OnComplete="CompleteTask" 
                                 OnDelete="DeleteTask"
                                 OnEdit="EditTask" />
                    </div>
                }
            </div>
        }
        <!-- Empty State -->
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-list-task text-muted" style="font-size: 4rem;"></i>
                <h4 class="text-muted mt-3">No tasks yet</h4>
                <p class="text-muted">Create your first task to get started!</p>
                <button class="btn btn-primary" @onclick="ToggleForm">
                    <i class="bi bi-plus"></i> Create Task
                </button>
            </div>
        }
    }
</div>

@code {
    private List<TaskResponseDto> tasks = new();
    private CreateTaskDto newTask = new();
    private bool isAuthenticated = false;
    private bool isLoading = true;
    private bool isCreating = false;
    private bool showForm = false;
    private string connectionStatus = "Disconnected";
    private AuthResponseDto? currentUser;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        isAuthenticated = await AuthService.IsAuthenticatedAsync();
        
        if (isAuthenticated)
        {
            currentUser = await AuthService.GetUserDataAsync();
            await LoadTasks();
            await SetupSignalR();
        }
        
        isLoading = false;
        AuthService.AuthStateChanged += OnAuthStateChanged;
    }

    private async Task LoadTasks()
    {
        try
        {
            tasks = await ApiService.GetTasksAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tasks: {ex.Message}");
        }
    }

    private async Task SetupSignalR()
    {
        var token = await AuthService.GetTokenAsync();
        SignalRService.TaskCreated += OnTaskCreated;
        SignalRService.TaskUpdated += OnTaskUpdated;
        SignalRService.TaskDeleted += OnTaskDeleted;
        SignalRService.ConnectionStatusChanged += OnConnectionStatusChanged;
        
        await SignalRService.StartAsync("https://localhost:7041/hubs/tasks", token);
    }

    private void ToggleForm()
    {
        showForm = !showForm;
        if (showForm)
        {
            newTask = new CreateTaskDto();
        }
    }

    private void CancelForm()
    {
        showForm = false;
        newTask = new CreateTaskDto();
    }

    private async Task CreateTask()
    {
        isCreating = true;
        
        try
        {
            if (newTask.DueDate.HasValue)
            {
                newTask.DueDate = DateTime.SpecifyKind(newTask.DueDate.Value, DateTimeKind.Utc);
            }
            
            var createdTask = await ApiService.CreateTaskAsync(newTask);
            if (createdTask != null)
            {
                showForm = false;
                newTask = new CreateTaskDto();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating task: {ex.Message}");
        }
        finally
        {
            isCreating = false;
        }
    }

    private async Task CompleteTask(Guid taskId)
    {
        try
        {
            await ApiService.CompleteTaskAsync(taskId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error completing task: {ex.Message}");
        }
    }

    private async Task DeleteTask(Guid taskId)
    {
        try
        {
            await ApiService.DeleteTaskAsync(taskId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting task: {ex.Message}");
        }
    }

    private async Task EditTask(Guid taskId)
    {
        // TODO: Implement edit functionality
        Console.WriteLine($"Edit task: {taskId}");
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    // SignalR Event Handlers
    private void OnTaskCreated(TaskResponseDto taskResponse)
    {
        tasks.Add(taskResponse);
        InvokeAsync(StateHasChanged);
    }

    private void OnTaskUpdated(TaskResponseDto taskResponse)
    {
        var index = tasks.FindIndex(t => t.Id == taskResponse.Id);
        if (index >= 0)
        {
            tasks[index] = taskResponse;
            InvokeAsync(StateHasChanged);
        }
    }

    private void OnTaskDeleted(Guid taskId)
    {
        tasks.RemoveAll(t => t.Id == taskId);
        InvokeAsync(StateHasChanged);
    }

    private void OnConnectionStatusChanged(string status)
    {
        connectionStatus = status;
        InvokeAsync(StateHasChanged);
    }

    private void OnAuthStateChanged()
    {
        InvokeAsync(async () =>
        {
            isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (isAuthenticated)
            {
                currentUser = await AuthService.GetUserDataAsync();
                await LoadTasks();
                await SetupSignalR();
            }
            else
            {
                currentUser = null;
                tasks.Clear();
                await SignalRService.StopAsync();
            }
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        AuthService.AuthStateChanged -= OnAuthStateChanged;
        if (SignalRService != null)
        {
            SignalRService.TaskCreated -= OnTaskCreated;
            SignalRService.TaskUpdated -= OnTaskUpdated;
            SignalRService.TaskDeleted -= OnTaskDeleted;
            SignalRService.ConnectionStatusChanged -= OnConnectionStatusChanged;
            await SignalRService.DisposeAsync();
        }
    }
}