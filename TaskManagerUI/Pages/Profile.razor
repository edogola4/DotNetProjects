@page "/profile"
@using TaskManagerUI.DTOs
@using TaskManagerUI.Services
@inject AuthService AuthService
@inject ApiService ApiService
@inject NavigationManager Navigation

<div class="container mt-4">
    @if (currentUser != null)
    {
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header d-flex align-items-center">
                        <i class="bi bi-person-circle fs-1 me-3"></i>
                        <div>
                            <h3 class="mb-0">User Profile</h3>
                            <small class="text-muted">Manage your account information</small>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Username</label>
                                    <div class="form-control-plaintext border rounded p-2 bg-light">
                                        <i class="bi bi-person me-2"></i>@currentUser.Username
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Email Address</label>
                                    <div class="form-control-plaintext border rounded p-2 bg-light">
                                        <i class="bi bi-envelope me-2"></i>@currentUser.Email
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row mt-4">
                            <div class="col-md-4">
                                <div class="card border-info">
                                    <div class="card-body text-center">
                                        <i class="bi bi-list-task text-info fs-1"></i>
                                        <h5 class="card-title mt-2">@(completedTasks + pendingTasks)</h5>
                                        <p class="card-text text-muted">Total Tasks</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card border-success">
                                    <div class="card-body text-center">
                                        <i class="bi bi-check-circle-fill text-success fs-1"></i>
                                        <h5 class="card-title mt-2">@completedTasks</h5>
                                        <p class="card-text text-muted">Completed Tasks</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card border-warning">
                                    <div class="card-body text-center">
                                        <i class="bi bi-clock-fill text-warning fs-1"></i>
                                        <h5 class="card-title mt-2">@pendingTasks</h5>
                                        <p class="card-text text-muted">Pending Tasks</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 d-flex justify-content-between">
                            <div>
                                <button class="btn btn-outline-secondary me-2" @onclick="GoBack">
                                    <i class="bi bi-arrow-left"></i> Back to Tasks
                                </button>
                                <button class="btn btn-outline-primary" @onclick="RefreshStats">
                                    <i class="bi bi-arrow-clockwise"></i> Refresh Stats
                                </button>
                            </div>
                            <button class="btn btn-danger" @onclick="HandleLogout">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center">
            <h3>Please login to view your profile</h3>
            <a href="/login" class="btn btn-primary">Login</a>
        </div>
    }
</div>

@code {
    private AuthResponseDto? currentUser;
    private int completedTasks = 0;
    private int pendingTasks = 0;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        var isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (!isAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // Ensure token is set on ApiService
        var token = await AuthService.GetTokenAsync();
        if (!string.IsNullOrEmpty(token))
        {
            ApiService.SetAuthToken(token);
        }

        currentUser = await AuthService.GetUserDataAsync();
        await LoadTaskStats();
    }

    private async Task LoadTaskStats()
    {
        try
        {
            Console.WriteLine("Loading task stats...");
            var stats = await ApiService.GetTaskStatsAsync();
            if (stats != null)
            {
                Console.WriteLine($"Stats loaded: Completed={stats.CompletedTasks}, Pending={stats.PendingTasks}");
                completedTasks = stats.CompletedTasks;
                pendingTasks = stats.PendingTasks;
            }
            else
            {
                Console.WriteLine("Stats returned null");
                completedTasks = 0;
                pendingTasks = 0;
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading task stats: {ex.Message}");
            completedTasks = 0;
            pendingTasks = 0;
        }
    }

    private async Task RefreshStats()
    {
        await LoadTaskStats();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }
}