@using TaskManagerUI.DTOs
@using TaskManagerUI.Models

<div class="task-card @(Task.IsCompleted ? "completed" : "")">
    <div class="task-header">
        <h5 class="task-title @(Task.IsCompleted ? "text-decoration-line-through" : "")">
            @Task.Title
        </h5>
        <span class="badge priority-@Task.Priority.ToString().ToLower()">
            @Task.Priority
        </span>
    </div>
    
    @if (!string.IsNullOrEmpty(Task.Description))
    {
        <p class="task-description @(Task.IsCompleted ? "text-muted" : "")">
            @Task.Description
        </p>
    }
    
    <div class="task-dates">
        @if (Task.DueDate.HasValue)
        {
            <span class="date-item @GetDueDateClass()">
                📅 Due: @Task.DueDate.Value.ToString("MMM dd, yyyy")
            </span>
        }
        <span class="date-item">
            🕐 Created: @Task.CreatedAt.ToString("MMM dd, yyyy")
        </span>
    </div>
    
    <div class="task-actions">
        <button class="btn btn-sm btn-outline-primary" 
                @onclick="() => OnEdit.InvokeAsync(Task.Id)"
                title="Edit task">
            <i class="bi bi-pencil me-1"></i>Edit
        </button>
        <button class="btn btn-sm btn-outline-danger" 
                @onclick="() => OnDelete.InvokeAsync(Task.Id)"
                title="Delete task">
            <i class="bi bi-trash3 me-1"></i>Delete
        </button>
        <button class="btn btn-sm @(Task.IsCompleted ? "btn-success" : "btn-outline-secondary")" 
                @onclick="() => OnComplete.InvokeAsync(Task.Id)"
                title="@(Task.IsCompleted ? "Mark as incomplete" : "Mark as complete")">
            @if (Task.IsCompleted)
            {
                <i class="bi bi-check-circle-fill me-1"></i><span>Completed</span>
            }
            else
            {
                <i class="bi bi-circle me-1"></i><span>Mark Complete</span>
            }
        </button>
    </div>
</div>

@code {
    [Parameter] public TaskResponseDto Task { get; set; } = new();
    [Parameter] public EventCallback<Guid> OnComplete { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }
    [Parameter] public EventCallback<Guid> OnEdit { get; set; }

    private string GetDueDateClass()
    {
        if (Task.IsCompleted) return "text-muted";
        if (Task.DueDate.HasValue && Task.DueDate.Value < DateTime.Now)
            return "text-danger fw-bold";
        return "text-muted";
    }
}